{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @askboss/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/[...path].ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/boss/:path*", "destination": "/index.html" },
    { "source": "/hr-demo", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
