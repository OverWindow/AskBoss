{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @askboss/web build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/entry.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/entry?_vercel_api_path=:path*" },
    { "source": "/api", "destination": "/api/entry?_vercel_api_path=" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
