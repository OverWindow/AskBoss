{
  "name": "@askboss/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --alias:@askboss/shared=../../packages/shared/src/index.ts --outfile=dist/server.js --sourcemap && esbuild api/index.ts --bundle --platform=node --format=esm --packages=external --alias:@askboss/shared=../../packages/shared/src/index.ts --outfile=dist/vercel.js --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@askboss/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/functions": "^2.2.13",
    "fastify": "^5.6.1",
    "openai": "^5.23.2",
    "postgres": "^3.4.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
